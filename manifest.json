{
  "manifest_version": 3,
  "name": "Sticky Notes",
  "version": "0.1.0",
  "description": "Stick a note on any web page and find it there when you come back.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sticky Notes",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/notes.js", "lib/ui.js", "content/styles.js", "content/content.js"]
    }
  ],
  "commands": {
    "add-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Add a sticky note to the current page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["note/note.html"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
